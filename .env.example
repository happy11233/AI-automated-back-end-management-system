DATABASE_URL=postgresql://rag_user:rag_password@localhost:5433/rag_agent
VECTOR_DATABASE_URL=postgresql+psycopg://rag_user:rag_password@localhost:5433/rag_agent
APP_ENVIRONMENT=development
# Local defaults only. Production requires an independent random URL-safe password.
# Existing PostgreSQL volumes require an explicit ALTER ROLE password rotation.
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_agent

# RabbitMQ 密码请使用随机 URL-safe 字符；Compose 必须显式提供。
RABBITMQ_USER=rag_worker
RABBITMQ_PASSWORD=replace_with_a_long_random_url_safe_password
CELERY_BROKER_URL=amqp://rag_worker:replace_with_a_long_random_url_safe_password@127.0.0.1:5672/company_rag
CELERY_TIMEZONE=Asia/Shanghai
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=540
CELERY_TASK_TIME_LIMIT_SECONDS=600
# Compose 固定使用 celery；只启动本地 API 时可改为 api，保留原有清理循环。
CONTEXT_CLEANUP_SCHEDULER=celery

# 默认关闭外部追踪；启用前配置独立的 LangSmith API Key 和所属区域 endpoint。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=company-rag-agent-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
# 默认不上传提示词、ERP/工资数据和工具输入输出。
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_TRACING_SAMPLING_RATE=0.1

# Production additions. Keep local mode compatible; enable jobs after migration.
REDIS_URL=
REDIS_KEY_PREFIX=company-rag-dev
RATE_LIMIT_ENABLED=false
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT_SECONDS=10
BACKGROUND_JOBS_ENABLED=false
BACKGROUND_JOB_INPUT_RETENTION_DAYS=7
MATERIALIZED_FILE_RETENTION_HOURS=24
CORS_ALLOWED_ORIGINS=
# /metrics stays unavailable until a dedicated token is configured.
METRICS_TOKEN=
ARTIFACT_STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=generated-files

DASHSCOPE_API_KEY=your_dashscope_api_key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_IMAGE_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1
BAILIAN_IMAGE_EDIT_MODEL=qwen-image-2.0-pro
BAILIAN_IMAGE_TIMEOUT_SECONDS=180
BAILIAN_CHAT_MODEL=qwen-plus
# 短任务优先使用的模型。留空时复用 BAILIAN_CHAT_MODEL。
BAILIAN_FAST_CHAT_MODEL=
BAILIAN_FAST_CHAT_MAX_TOKENS=512
BAILIAN_REQUEST_TIMEOUT_SECONDS=60
BAILIAN_MAX_RETRIES=1
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
BAILIAN_EMBEDDING_DIMENSIONS=1024

# RAG 查询 embedding 短期缓存，避免同一权限范围内重复调用远程 embedding 服务。
RAG_EMBEDDING_CACHE_TTL_SECONDS=300
RAG_EMBEDDING_CACHE_MAX_ENTRIES=512
RAG_CUSTOMER_MULTI_QUERY_COUNT=1
RAG_CONTEXT_MAX_CHARS=12000
RAG_CHUNK_MAX_CHARS=3000
CUSTOMER_CONTEXT_PARALLEL_ENABLED=true

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI 对话记录保留 15 天。过期会话会在后端启动时自动清理。
CHAT_MESSAGE_RETENTION_DAYS=15
CHAT_THREAD_RETENTION_DAYS=15
CLOSED_THREAD_RETENTION_DAYS=15

# 飞书 MCP 集成配置。不填时项目会继续使用本地 docs/ 和 data/tickets.jsonl。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 多个飞书云文档用英文逗号隔开。
# 支持 document_id 或 document_id|标题，例如：doccnxxxx|退款政策,doccn yyyy|售后流程
FEISHU_DOCUMENT_IDS=

# 飞书多维表格，用来当外部工单系统。
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_TICKET_ID_FIELD=工单号
FEISHU_TICKET_TITLE_FIELD=标题
FEISHU_TICKET_DESCRIPTION_FIELD=描述
FEISHU_TICKET_PRIORITY_FIELD=优先级
FEISHU_TICKET_REQUESTER_FIELD=申请人
FEISHU_TICKET_SOURCE_FIELD=来源
FEISHU_TICKET_STATUS_FIELD=状态
FEISHU_TICKET_CREATED_AT_FIELD=创建时间

# ERP 连接层配置。ERP_PROVIDER 可选 erpnext / kingdee / yonyou。
# ERPNext 使用 token API 鉴权：Authorization: token api_key:api_secret
ERP_PROVIDER=erpnext
# 本地 ERPNext 用 Docker 启动时：
# - 后端也在 Docker 容器里运行：ERP_BASE_URL=http://host.docker.internal:8080
# - 后端直接在宿主机运行：ERP_BASE_URL=http://127.0.0.1:8080
ERP_BASE_URL=
ERP_API_KEY=
ERP_API_SECRET=
MCP_TOOL_TIMEOUT_SECONDS=15
ERP_TIMEOUT_SECONDS=8

# 金蝶连接层预留配置，拿到真实接口规范和凭据后启用。
ERP_KINGDEE_BASE_URL=
ERP_KINGDEE_ACCOUNT_ID=
ERP_KINGDEE_APP_ID=
ERP_KINGDEE_APP_SECRET=

# 用友连接层预留配置，拿到真实接口规范和凭据后启用。
ERP_YONYOU_BASE_URL=
ERP_YONYOU_TENANT_ID=
ERP_YONYOU_APP_KEY=
ERP_YONYOU_APP_SECRET=

# RAG PDF 解析器。auto=优先 MinerU，失败回退 PyPDFLoader；mineru=强制 MinerU；pypdf=只用 PyPDFLoader。
RAG_PDF_PARSER=auto
RAG_MINERU_COMMAND=mineru
RAG_MINERU_BACKEND=pipeline
RAG_MINERU_TIMEOUT_SECONDS=180
RAG_MINERU_MODEL_SOURCE=

# 客服外部消息 webhook。用于 n8n、邮箱、Amazon 消息中转服务调用。
# 不要使用示例值，生产环境请设置为足够长的随机字符串。
CUSTOMER_SERVICE_WEBHOOK_SECRET=
CUSTOMER_SERVICE_WEBHOOK_SECRET_HEADER=X-Customer-Service-Webhook-Secret

# 邮件发送配置。财务在 AI 对话里明确说“发送到我的邮箱”时，系统会使用这里的 SMTP 真实发送附件。
# 不配置时仍会生成文件和下载中心记录，但不会假装发送成功。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

# 平台业务动作执行器。用于把 AI 生成的 Listing 草稿/客服回复草稿真实写入 Amazon、客服系统、影刀或 n8n。
# 不配置时系统只会把草稿标记为“等待外部执行器”，不会假装写回成功。
PLATFORM_ACTION_EXECUTOR_WEBHOOK_URL=
PLATFORM_ACTION_EXECUTOR_API_KEY=
PLATFORM_ACTION_EXECUTOR_TIMEOUT_SECONDS=12
PLATFORM_ACTION_EXECUTOR_ALLOWED_HOSTS=n8n.example.com,*.trusted-workflows.example.com
PLATFORM_ACTION_EXECUTOR_ALLOWED_SCHEMES=https
PLATFORM_ACTION_EXECUTOR_ALLOWED_PORTS=443
PLATFORM_ACTION_EXECUTOR_ALLOW_PRIVATE_NETWORK=false
PLATFORM_ACTION_EXECUTOR_REQUIRE_ALLOWLIST=true
PLATFORM_ACTION_EXECUTION_CALLBACK_SECRET=change-me-platform-callback-secret
PLATFORM_ACTION_EXECUTION_CALLBACK_SIGNATURE_HEADER=X-Platform-Callback-Signature
PLATFORM_ACTION_EXECUTION_CALLBACK_TIMESTAMP_HEADER=X-Platform-Callback-Timestamp
PLATFORM_ACTION_EXECUTION_CALLBACK_NONCE_HEADER=X-Platform-Callback-Nonce
PLATFORM_ACTION_EXECUTION_CALLBACK_TOLERANCE_SECONDS=300

# AIOps 独立运维服务。平台监控中心会通过后端代理读取问题列表、详情和修复接口。
# 平台 API 在 Docker 容器内、AIOps 在宿主机运行时，使用 http://host.docker.internal:9900。
# 两个服务在同一 Docker 网络时，使用 AIOps 服务名；后端在宿主机运行时使用 127.0.0.1。
AIOPS_SERVICE_URL=http://host.docker.internal:9900
AIOPS_SERVICE_TIMEOUT_SECONDS=8
AIOPS_MONITORING_POLL_INTERVAL_SECONDS=300
# AIOps 内网健康探针密钥。配置后启用 /internal/aiops/* 探针，供 AIOps 服务带 Header 调用。
AIOPS_PROBE_SECRET=change-me-aiops-probe-secret

# 财务工资表微信发送执行器。
# 可选：manual_final_click（默认，生成文件后人工发送）、n8n（投递 Webhook）、tagui_mac（Mac 本机个人微信半自动执行）。
# n8n Webhook URL 也会复用 PLATFORM_ACTION_EXECUTOR_* allowlist 做安全校验。
FINANCE_WECHAT_EXECUTOR_MODE=manual_final_click
FINANCE_WECHAT_N8N_WEBHOOK_URL=
FINANCE_WECHAT_N8N_API_KEY=
FINANCE_WECHAT_EXECUTOR_TIMEOUT_SECONDS=12
# Mac 个人微信半自动演示。开启后需要在 macOS 系统设置里给运行后端的终端/应用授予“辅助功能”权限。
# 执行器只会打开微信、搜索联系人、粘贴附件，绝不会自动点击发送。
FINANCE_WECHAT_MAC_RPA_ENABLED=false
FINANCE_WECHAT_MAC_APP_NAME=WeChat

# Amazon Seller Central Playwright MCP。
# 默认关闭真实浏览器动作；开启前请先在本机浏览器登录 Seller Central，并配置独立用户目录/字段选择器。
AMAZON_PLAYWRIGHT_ENABLED=false
AMAZON_SELLER_CENTRAL_URL=https://sellercentral.amazon.com/
AMAZON_PLAYWRIGHT_USER_DATA_DIR=
AMAZON_PLAYWRIGHT_SELECTOR_PROFILE=
AMAZON_PLAYWRIGHT_TIMEOUT_SECONDS=20
AMAZON_PLAYWRIGHT_BROWSER_CHANNEL=chrome
AMAZON_PLAYWRIGHT_HEADLESS=false

# 消息发送 MCP。
# 默认不开启真实发送，避免演示时误发。确认后发送邮箱或企业微信文件时可打开真实发送开关。
MESSAGE_SENDER_REAL_SEND_ENABLED=false
MESSAGE_SENDER_ALLOWED_EMAIL_DOMAINS=
ENTERPRISE_WECHAT_WEBHOOK_URL=

# 企业微信应用发送。用于后端直连企业微信，把 AI 生成的 Excel / Word 文件发给成员、部门或群聊。
# 真实发送仍要求 MESSAGE_SENDER_REAL_SEND_ENABLED=true，并且聊天里完成接收对象和敏感数据确认。
WECHAT_WORK_CORP_ID=
WECHAT_WORK_AGENT_ID=
WECHAT_WORK_SECRET=
WECHAT_WORK_TIMEOUT_SECONDS=12
